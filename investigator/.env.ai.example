# AI processing is OFF unless explicitly enabled.
# Do not put secrets in Git, NEXT_PUBLIC_* environment variables, or browser code.
INVESTIGATOR_AI_ENABLED=false

# private_only: only privately controlled Qwen may receive case content.
# approved_external: allow only explicitly listed external providers.
INVESTIGATOR_AI_DATA_POLICY=private_only
INVESTIGATOR_AI_PROVIDER=private_qwen

# Explicitly approve organisations (UUIDs) before enabling any case processing.
INVESTIGATOR_AI_APPROVED_ORG_IDS=

# External models stay blocked unless the policy is approved_external AND
# their exact provider names are listed, e.g. anthropic,huggingface.
INVESTIGATOR_AI_APPROVED_EXTERNAL_PROVIDERS=

# Private Qwen, reachable only via authenticated gateway over trusted TLS.
# Use a private DNS / VPN / cloud private connectivity endpoint; do not
# expose raw vLLM directly to the internet.
QWEN_PRIVATE_GATEWAY_URL=https://qwen.internal.example/v1
QWEN_PRIVATE_ALLOWED_HOST=qwen.internal.example
QWEN_PRIVATE_API_KEY=
QWEN_PRIVATE_MODEL=Qwen/Qwen3-8B

# Only used if external Anthropic is explicitly authorised.
INVESTIGATOR_ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_KEY=
# Only used for separately authorised Hugging Face OCR/transcription.
HF_API_TOKEN=

# Alternative private backend: OpenAI-compatible open-weight model.
# Select INVESTIGATOR_AI_PROVIDER=private_open_weight to use these values.
# Example: gpt-oss-20b or Ministral 3 8B, deployed by you.
PRIVATE_AI_GATEWAY_URL=https://inference.internal.example/v1
PRIVATE_AI_ALLOWED_HOST=inference.internal.example
PRIVATE_AI_API_KEY=
PRIVATE_AI_MODEL=openai/gpt-oss-20b
